+  <div class="tabs">${abas.map(a=>`<button data-aba="${a[0]}" class="${V.aba===a[0]?'on':''}">${a[1]}</button>`).join('')}</div>
+  ${corpo}`}
+
+function aviso(p){const pz=prazos(p,S.cfg).filter(d=>d.kind!=='info'&&!d.done&&d.dias<=60);
