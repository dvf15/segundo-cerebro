new file mode 100644
index 0000000..a5ff30a
--- /dev/null
+++ b/public/legalizacoes.html
@@ -0,0 +1,435 @@
+<!DOCTYPE html>
+<html lang="pt-BR">
+<head>
+<meta charset="UTF-8">
+<meta name="robots" content="noindex, nofollow">
+<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'">
+<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover">
+<meta name="apple-mobile-web-app-capable" content="yes">
+<meta name="apple-mobile-web-app-status-bar-style" content="default">
+<meta name="apple-mobile-web-app-title" content="Radar Legalizações">
+<meta name="theme-color" content="#00616f">
+<title>Radar de Legalizações Promo — Sorteios e Compre e Ganhe na SPA/MF</title>
+<link rel="icon" type="image/png" sizes="192x192" href="legalizacoes-icon-192.png">
+<link rel="apple-touch-icon" sizes="180x180" href="legalizacoes-icon-180.png">
+<link rel="manifest" href="legalizacoes.webmanifest">
+<style>
+*{-webkit-tap-highlight-color:transparent}body{margin:0}[hidden]{display:none!important}
+/* Layout: mesa de processo. Resumo de prazos no topo, depois a fila de prazos e as promoções; cada promoção abre como um dossiê com abas. */
+:root{
+  color-scheme:light;
+  --bg:#ffffff; --surface:#e5ded4; --field:#ffffff; --sunk:#d6cec3; --line:#ccc5bc;
+  --fg:#0d454a; --muted:rgba(13,69,74,.66);
+  --accent:#00616f; --accent-fg:#ffffff; --accent-soft:rgba(0,97,111,.1);
+  --bad:#b23b3b; --bad-soft:rgba(205,81,81,.16); --warn:#8f5a10; --warn-soft:rgba(237,167,84,.3);
+  --good:#2c7a50; --good-soft:rgba(108,198,128,.3); --info:#0d454a; --info-soft:rgba(204,197,188,.55);
+  --display:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
+  --body:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
+  --r:12px;
+}
+*{box-sizing:border-box}
+body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:15px;line-height:1.5}
+.wrap{max-width:1080px;margin:0 auto;padding-block:20px 48px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:20px}
+h1,h2,h3{font-family:var(--display);margin:0;text-wrap:balance;line-height:1.2}
+h1{font-size:1.45rem;font-weight:800;color:var(--accent)} h2{font-size:1.1rem;font-weight:800;color:var(--accent)} h3{font-size:1rem;font-weight:800;color:var(--accent)}
+p{margin:0}
+a{color:var(--accent)}
+.top{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:14px}
+.top .sub{color:var(--muted);font-size:.85rem}
+.nav{display:flex;flex-wrap:wrap;gap:6px}
+button,.btn{font:inherit;font-weight:500;font-size:.9rem;border:1px solid var(--line);background:var(--field);color:var(--fg);padding:9px 13px;font-weight:700;border-radius:var(--r);cursor:pointer}
+button:hover{border-color:var(--accent)}
+button.pri{background:var(--accent);color:var(--accent-fg);border-color:var(--accent)}
+button.danger{color:var(--bad);border-color:var(--bad)}
+button.on{background:var(--accent);color:var(--accent-fg);border-color:var(--accent)}
+button.link{border:0;background:none;color:var(--accent);padding:0;text-decoration:underline}
+:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.eyebrow{font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
+.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
+.kpi{background:var(--field);padding:12px 14px;display:flex;flex-direction:column;gap:2px}
+.kpi b{font-family:var(--display);font-size:1.7rem;font-variant-numeric:tabular-nums;line-height:1.1}
+.kpi.bad b{color:var(--bad)} .kpi.warn b{color:var(--warn)}
+.sec{display:flex;flex-direction:column;gap:10px}
+.sechead{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between}
+.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r)}
+.row{display:grid;grid-template-columns:92px minmax(0,1fr) auto;gap:4px 14px;padding:10px 14px;border-top:1px solid var(--line);align-items:start}
+.row:first-child{border-top:0}
+.row .dt{font-variant-numeric:tabular-nums;font-weight:600}
+.row .dt small{display:block;font-weight:400;color:var(--muted);font-size:.78rem}
+.row .what{min-width:0}
+.row .what small{display:block;color:var(--muted);font-size:.8rem}
+.row .act{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
+.row.done .what>span{text-decoration:line-through;color:var(--muted)}
+@media (max-width:560px){.row{grid-template-columns:80px minmax(0,1fr)}.row .act{grid-column:1/-1;justify-content:flex-start}}
+.pill{display:inline-block;font-size:.72rem;font-weight:600;padding:2px 8px;border-radius:99px;white-space:nowrap;letter-spacing:.02em}
+.pill.vencido{background:var(--bad);color:#ffffff} .pill.critico{background:var(--bad-soft);color:var(--bad)}
+.pill.atencao{background:var(--warn-soft);color:var(--warn)} .pill.ok,.pill.feito{background:var(--good-soft);color:var(--good)}
+.pill.info,.pill.ex{background:var(--info-soft);color:var(--info)}
+.promo{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 14px;padding:12px 14px;border-top:1px solid var(--line);cursor:pointer;text-align:left;width:100%;border-left:0;border-right:0;border-bottom:0;border-radius:0;background:none}
+.promo:first-child{border-top:0}
+.promo:hover{background:var(--sunk)}
+.promo .meta{color:var(--muted);font-size:.82rem;font-weight:400}
+.promo .right{display:flex;flex-direction:column;gap:4px;align-items:flex-end}
+.tabs{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
+.note{background:var(--accent-soft);border-radius:var(--r);padding:10px 12px;font-size:.88rem}
+.note.warn{background:var(--warn-soft);color:var(--warn)} .note.bad{background:var(--bad-soft);color:var(--bad)}
+.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}
+label{display:flex;flex-direction:column;gap:4px;font-size:.82rem;font-weight:500;color:var(--muted);min-width:0}
+label.chk{flex-direction:row;align-items:center;gap:8px;color:var(--fg);font-size:.9rem}
+input,select,textarea{font:inherit;color:var(--fg);background:var(--field);border:1px solid var(--line);border-radius:var(--r);padding:7px 9px;min-width:0;width:100%}
+input[type=checkbox]{width:auto}
+textarea{min-height:160px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.8rem}
+.pad{padding:14px;display:flex;flex-direction:column;gap:14px}
+.item{display:grid;grid-template-columns:minmax(0,1fr) 140px;gap:6px 12px;padding:10px 14px;border-top:1px solid var(--line)}
+.item:first-child{border-top:0}
+.item small{display:block;color:var(--muted);font-size:.8rem}
+.item .extra{grid-column:1/-1;display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px}
+@media (max-width:560px){.item{grid-template-columns:minmax(0,1fr)}}
+.crit{font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--bad)}
+.crit.m{color:var(--warn)}
+.bar{height:6px;background:var(--sunk);border-radius:99px;overflow:hidden;width:120px}
+.bar i{display:block;height:100%;background:var(--accent)}
+.legal dt{font-weight:600;margin-top:10px} .legal dd{margin:2px 0 0;color:var(--muted)}
+footer{color:var(--muted);font-size:.8rem;border-top:1px solid var(--line);padding-top:12px}
+.empty{padding:20px 14px;color:var(--muted)}
+</style>
+</head>
+<body>
+
+<div class="wrap">
