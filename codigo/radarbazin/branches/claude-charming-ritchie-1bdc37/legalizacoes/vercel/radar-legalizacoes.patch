@@ -23,7 +23,7 @@ import type { NextRequest } from "next/server";
 /* Páginas e recursos que podem ser abertos por qualquer pessoa. */
 const PUBLICO: RegExp[] = [
   // ferramentas comerciais
-  /^\/(operacoes|quiosques|midia|obras|apresentacao|simulador-estrutura|simulador-remuneracao|pesquisa-executivos|clausulas|renovacoes|vendas)\.html$/,
