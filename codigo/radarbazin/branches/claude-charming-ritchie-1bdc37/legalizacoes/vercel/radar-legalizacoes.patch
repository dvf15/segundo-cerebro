   // vídeos do passo a passo do Radar de Renovações (aba Como usar)
   /^\/renovacoes-[a-z0-9-]+\.mp4$/,
   // vídeos do passo a passo do Radar de Vendas (aba Como funciona)
@@ -205,5 +205,5 @@ export async function middleware(req: NextRequest) {
    Ao incluir uma ferramenta nova, acrescente-a nas duas listas. */
 export const config = {
   matcher:
-    "/((?!_next/static|_next/image|(?:operacoes|quiosques|midia|obras|apresentacao|simulador-estrutura|simulador-remuneracao|pesquisa-executivos|clausulas|renovacoes|vendas)\\.html$|(?:renovacoes|vendas)-[a-z0-9-]+\\.mp4$|[a-z0-9-]+\\.webmanifest$|[a-z0-9-]+-icon(?:-\\d+)?\\.(?:png|svg)$|icon(?:-pink)?\\.(?:png|svg)$|sw-[a-z0-9-]+\\.js$|exemplos/|favicon\\.ico$).*)",
+    "/((?!_next/static|_next/image|(?:operacoes|quiosques|midia|obras|apresentacao|simulador-estrutura|simulador-remuneracao|pesquisa-executivos|clausulas|renovacoes|vendas|legalizacoes)\\.html$|(?:renovacoes|vendas)-[a-z0-9-]+\\.mp4$|[a-z0-9-]+\\.webmanifest$|[a-z0-9-]+-icon(?:-\\d+)?\\.(?:png|svg)$|icon(?:-pink)?\\.(?:png|svg)$|sw-[a-z0-9-]+\\.js$|exemplos/|favicon\\.ico$).*)",
 };
