+ ${p.mecanica==='compre'?`<div class="note">Compre e ganhe com quantidade fixa de prêmios ou limitado a estoque entra como concurso (primeiros consumidores a cumprir o critério) ou vale-brinde, conforme o art. 2º, III e IV. Confirme o enquadramento com a SPA antes de protocolar.</div>`:''}
+ <label>Anotações<input id="f_notas" data-f="notas" value="${esc(p.notas)}"></label>`}
+
+function promo(){const p=P();if(!p)return painel();
+  const abas=[['crono','Cronograma'],['docs','Documentos'],['reg','Regulamento'],['pc','Prestação de contas'],['dados','Dados']];
+  let corpo='';
+  if(V.aba==='crono')corpo=`<div class="panel">${prazos(p,S.cfg).map(d=>linha(d,p)).join('')||'<div class="empty">Informe as datas na aba Dados para gerar o cronograma.</div>'}</div>`;
+  if(V.aba==='docs')corpo=`<div class="panel">${DOCS.filter(d=>!d.se||d.se(p)).map(d=>{const o=p.docs[d.k]||{};
