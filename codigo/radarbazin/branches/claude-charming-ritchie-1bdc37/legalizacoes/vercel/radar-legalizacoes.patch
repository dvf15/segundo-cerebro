+   (pz.length?pz.map(d=>`- ${fmt(d.date)} (${d.dias<0?'VENCIDO há '+(-d.dias)+' dias':d.dias===0?'hoje':'em '+d.dias+' dias'}): ${d.t} [${d.b}]`).join('\n'):'- Nenhum')+
