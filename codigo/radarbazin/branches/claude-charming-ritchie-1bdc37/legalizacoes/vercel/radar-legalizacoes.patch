+   `\n\nBase: Lei 5.768/1971, Decreto 70.951/1972 e Portaria SEAE/ME 7.638/2022. Pedido e prestação de contas pelo SCPC (SPA/MF).`}
+function ics(){const L=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Radar de Legalizacoes Promo//PT'];
