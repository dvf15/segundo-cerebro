+    return `<div class="item"><div>${esc(d.t)}<small>${esc(d.b)}</small>${venc?'<small style="color:var(--bad)">A validade termina antes do último dia de protocolo.</small>':''}</div>
+    <select id="d_${d.k}" data-doc="${d.k}" data-c="st">${opts(DOCST,o.st||'pendente')}</select>
+    <div class="extra"><input id="dl_${d.k}" placeholder="Link do arquivo (Drive, SharePoint…)" data-doc="${d.k}" data-c="link" value="${esc(o.link)}">
+    ${d.val?`<label>Validade<input type="date" id="dv_${d.k}" data-doc="${d.k}" data-c="validade" value="${o.validade||''}"></label>`:''}
+    <input id="do_${d.k}" placeholder="Observação" data-doc="${d.k}" data-c="obs" value="${esc(o.obs)}"></div></div>`}).join('')}</div>
+    <p class="eyebrow">Lista do art. 18 e Anexo I da Portaria SEAE/ME 7.638/2022. A SPA pode pedir documentos complementares (art. 20, § 3º).</p>`;
+  if(V.aba==='reg'){const it=REG.filter(r=>!r.se||r.se(p)),aj=it.filter(r=>p.reg[r.k]==='ajustar').length,pe=it.filter(r=>!p.reg[r.k]||p.reg[r.k]==='pendente').length;
+    corpo=`<div class="note ${aj?'bad':pe?'warn':''}">${aj} ponto(s) a ajustar e ${pe} a revisar, de ${it.length}. A criticidade é uma classificação desta ferramenta para ordenar a revisão.</div>
+    <div class="panel">${it.map(r=>`<div class="item"><div><span class="crit ${r.c==='m'?'m':''}">${r.c==='a'?'Criticidade alta':'Criticidade média'}</span><br>${esc(r.t)}<small>${esc(r.b)}</small></div>
+    <select id="r_${r.k}" data-reg="${r.k}">${opts(REGST,p.reg[r.k]||'pendente')}</select></div>`).join('')}</div>`}
+  if(V.aba==='pc'){const pz=prazos(p,S.cfg).find(d=>d.k==='pc');
+    corpo=`${pz?`<div class="note">Prazo final da prestação de contas: <b>${fmt(pz.date)}</b> (${quando(pz)||'feito'}). ${fam(p)==='v'?'Vale-brinde: art. 48.':'Demais modalidades: art. 49.'} Guarde cupons e termos de adesão até a homologação.</div>`:''}
+    <div class="panel">${PC.filter(d=>!d.se||d.se(p)).map(d=>{const o=p.pc[d.k]||{};return `<div class="item"><div>${esc(d.t)}<small>${esc(d.b)}</small></div>
+    <select id="p_${d.k}" data-pc="${d.k}" data-c="st">${opts(PCST,o.st||'pendente')}</select>
+    <div class="extra"><input id="pl_${d.k}" placeholder="Link do arquivo" data-pc="${d.k}" data-c="link" value="${esc(o.link)}"></div></div>`}).join('')}</div>`}
+  if(V.aba==='dados')corpo=`<div class="panel pad">${form(p)}
+    <div class="tabs">${V.del===0?`<button class="danger" data-act="del">Excluir promoção</button>`:V.del===1?`<span>Excluir "${esc(p.titulo)}" e todos os registros dela?</span> <button class="danger" data-act="del">Sim, continuar</button> <button data-act="nodel">Cancelar</button>`:`<span>Confirmação final: a exclusão não pode ser desfeita.</span> <button class="danger" data-act="del">Excluir definitivamente</button> <button data-act="nodel">Cancelar</button>`}</div></div>`;
+  return `<div class="sechead"><div><button class="link" data-go="painel">← Painel</button>
